# Copy to .env for Docker Compose. Generate a key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_KEY=
APP_ORIGIN=http://localhost:3001
COOKIE_SECURE=false
# Full native document editors: docker compose --profile editors up -d --build
# Generate a separate random secret of at least 32 characters for this service.
OFFICE_JWT_SECRET=
OFFICE_PUBLIC_URL=http://localhost:8082
OFFICE_INTERNAL_URL=http://documentserver
OFFICE_APP_URL=http://office:3001
# For Node, export variables in the shell or use node --env-file=.env server/index.js.
# Local AI example: http://localhost:11434/v1
# Compose AI example: http://ollama:11434/v1
AI_BASE_URL=
AI_MODEL=qwen2.5:7b
AI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# Mount the organization certificate separately; never commit certificates.
PDF_P12_PATH=
PDF_P12_PASSPHRASE=
# Optional path to openssl executable; container includes OpenSSL.
OPENSSL_BIN=openssl

# Optional assistant service. OpenCode takes priority over AI_BASE_URL.
AI_VISION=false
OPENCODE_BASE_URL=
OPENCODE_API=current
OPENCODE_AGENT=
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

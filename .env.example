# Copy to .env for Docker Compose. Generate a key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_KEY=
APP_ORIGIN=http://localhost:3001
COOKIE_SECURE=false
# For Node, export variables in the shell or use node --env-file=.env server/index.js.
# Local AI example: http://localhost:11434/v1
# Compose AI example: http://ollama:11434/v1
AI_BASE_URL=
AI_MODEL=qwen2.5:7b
AI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# Mount the organization certificate separately; never commit certificates.
PDF_P12_PATH=
PDF_P12_PASSPHRASE=
# Optional path to openssl executable; container includes OpenSSL.
OPENSSL_BIN=openssl
# Romania branch only. Use test until real sandbox validation has passed.
ANAF_ENV=test
ANAF_ALLOW_PRODUCTION=false
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=
ANAF_REDIRECT_URI=
# Generate independently: 32 random bytes encoded as 64 hex characters.
SPV_ENCRYPTION_KEY=
# Optional alternative to OAuth connection; never commit a real token.
ANAF_ACCESS_TOKEN=

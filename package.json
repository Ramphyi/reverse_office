{
  "name": "reverse-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:office": "playwright test --config playwright.office.config.js",
    "license:report": "node scripts/license-audit.mjs",
    "license:check": "node scripts/license-audit.mjs --check",
    "test:studio": "playwright test --config playwright.studio.config.js",
    "studio:dev": "node scripts/studio-dev.mjs",
    "studio:ai": "node scripts/studio-ai-gateway.mjs",
    "company:preview": "node scripts/company-preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@signpdf/placeholder-pdf-lib": "^3.2.6",
    "@signpdf/signpdf": "^3.2.5",
    "@signpdf/utils": "^3.3.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  },
  "overrides": {
    "image-size": "2.0.4",
    "uuid": "11.1.1"
  },
  "license": "MIT"
}
